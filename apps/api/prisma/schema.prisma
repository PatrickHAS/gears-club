generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshSessions         RefreshSession[]
  profile                 PlayerProfile?
  matchDisputeResolutions MatchDisputeResolution[]

  @@map("users")
}

model RefreshSession {
  id        String @id @default(uuid())
  userId    String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PlayerProfile {
  id     String @id @default(uuid())
  userId String @unique

  gamertag  String? @unique
  country   String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             PlayerRating?
  matchmakingRegions PlayerMatchmakingRegion[]
  matchParticipants  MatchParticipant[]
  matchResultReports MatchResultReport[]
  disputeEvidences   MatchDisputeEvidence[]

  @@map("player_profiles")
}

model PlayerRating {
  id              String @id @default(uuid())
  playerProfileId String @unique

  elo     Int @default(1000)
  wins    Int @default(0)
  losses  Int @default(0)
  matches Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@index([elo])
  @@map("player_ratings")
}

model PlayerMatchmakingRegion {
  id              String @id @default(uuid())
  playerProfileId String
  country         String @db.VarChar(2)

  createdAt DateTime @default(now())

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  @@unique([playerProfileId, country])
  @@index([country])
  @@map("player_matchmaking_regions")
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  AWAITING_VALIDATION
  COMPLETED
  DISPUTED
  CANCELLED
}

enum MatchTeam {
  COG
  LOCUST
}

model Match {
  id String @id @default(uuid())

  // Identificador único da reserva no Redis.
  reservationId String? @unique @db.Uuid

  mode   String @default("DEMOLITION")
  region String @db.VarChar(2)

  status MatchStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  participants      MatchParticipant[]
  resultReports     MatchResultReport[]
  disputeEvidences  MatchDisputeEvidence[]
  disputeResolution MatchDisputeResolution?

  @@index([status, createdAt])
  @@index([region])
  @@map("matches")
}

model MatchParticipant {
  id String @id @default(uuid())

  matchId         String
  playerProfileId String

  team      MatchTeam
  isCaptain Boolean   @default(false)

  createdAt DateTime @default(now())

  match         Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Restrict)

  @@unique([matchId, playerProfileId])
  @@index([playerProfileId])
  @@index([matchId, team])
  @@map("match_participants")
}

model MatchResultReport {
  id String @id @default(uuid())

  matchId   String
  captainId String

  winnerTeam MatchTeam

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  captain PlayerProfile @relation(fields: [captainId], references: [id], onDelete: Restrict)

  @@unique([matchId, captainId])
  @@index([matchId])
  @@map("match_result_reports")
}

model MatchDisputeEvidence {
  id String @id @default(uuid())

  matchId   String
  captainId String

  // Referência à imagem armazenada.
  imageKey String

  // Informações para auditoria.
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  captain PlayerProfile @relation(fields: [captainId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([captainId])
  @@map("match_dispute_evidences")
}

model MatchDisputeResolution {
  id String @id @default(uuid())

  matchId String @unique
  adminId String

  winnerTeam MatchTeam

  // Evidências consideradas na decisão administrativa.
  evidenceIds String[]

  // Confirmação manual da conferência das oito gamertags.
  gamertagsVerified Boolean

  // Justificativa registrada pelo administrador.
  reason String @db.Text

  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("match_dispute_resolutions")
}
